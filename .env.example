# Stockpile — Docker Compose configuration.
#
#   cp .env.example .env
#   docker compose up --build
#
# `.env` is gitignored; this template is not, so never put a real secret in
# it. Compose reads this file for both the development and production stacks.
#
# In CI/CD nothing here is used: every value comes from GitHub Secrets and is
# written to the deployment host's own .env by the deploy workflow.

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

# `production` turns on the server's strict checks: TOKEN_PEPPER and
# EMAIL_HOST become mandatory, APP_URL must be https, and the database
# connection requires TLS.
APP_ENV=development
APP_NAME=Stockpile

# The public URL the browser reaches the app on. Every emailed link is built
# from this rather than from a request header, so a spoofed Host cannot aim a
# password-reset link at someone else's domain.
APP_URL=http://localhost:8080

# Exact origins allowed to call the API from a browser. There is no wildcard.
# With the bundled nginx the client is same-origin, so this only matters if
# something else calls the API cross-origin.
CORS_ORIGINS=http://localhost:8080

# Host port the app is published on.
WEB_PORT=8080

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# The API's DATABASE_URL is assembled from these by Compose; there is no
# separate connection string to keep in step.

POSTGRES_USER=stockpile
POSTGRES_DB=stockpile

# No default anywhere: Compose refuses to start without it, which is
# deliberate — a database whose password came from a template is not private.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Host port for psql. Bound to 127.0.0.1 only, and not published at all by the
# production stack.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------

# Mixed into every session and link token, so a stolen database alone cannot
# be used to forge one. Required in production, minimum 32 characters.
# Generate with:  docker compose run --rm --entrypoint /app/bin/server api --help
# or, without Docker:  cd server && dart run bin/generate_secret.dart
#
# Changing it signs everyone out and voids every outstanding reset link.
TOKEN_PEPPER=

# ---------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------
# Leave EMAIL_HOST empty in development and mail is logged rather than sent;
# the invite endpoint then returns the invitation link directly so the flow
# still completes. In production an empty EMAIL_HOST refuses to boot, because
# password resets would silently fail.
#
# Gmail / Google Workspace: smtp.gmail.com, port 587, EMAIL_SSL=false, and an
# app password rather than the account password.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SSL=false
EMAIL_ALLOW_INSECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Stockpile <no-reply@localhost>

# ---------------------------------------------------------------------
# Brute-force protection
# ---------------------------------------------------------------------
# The lockout expires by itself after LOCKOUT_MINUTES, so it can never be used
# to lock someone out permanently.

MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------
# Production only (docker-compose.prod.yml)
# ---------------------------------------------------------------------

# Where published images are pulled from, and which tag to run. The deploy
# workflow sets IMAGE_TAG to the commit SHA, which is what makes a rollback a
# matter of changing one value.
#
# The path is deliberately short — `docker ps` shows the image, and a
# 60-character repository path pushes every other column off the screen.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=muakinyele/inv
IMAGE_TAG=latest
