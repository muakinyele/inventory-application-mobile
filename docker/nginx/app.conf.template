# Rendered by nginx's entrypoint at container start, so ${API_UPSTREAM} is
# chosen per environment and the image itself stays environment-agnostic.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Bodies are small — JSON, and a logo upload capped at 5 MB by the app.
    # The margin covers base64's ~33% inflation on the wire.
    client_max_body_size 8m;

    # Hardening for the documents nginx serves itself. Deliberately *not* set
    # at server level: the API already sends its own, and a server-level
    # add_header would append a second identical copy to every proxied
    # response. nginx only inherits these into a location that declares none
    # of its own, so `location /api/` is left alone by having them here.

    # WHAT THE APP PAGE IS ALLOWED TO DO. The API has had a policy since it
    # was written (`default-src 'none'`); the page that nginx serves had none
    # at all, so anything that ever did get onto it could load a script from
    # anywhere and post the workspace wherever it liked.
    #
    # Each source is here because the app measurably needs it, not on
    # principle — this was built by loading the real bundle behind the policy
    # and reading the console until nothing was refused:
    #
    #   script-src   the engine is fetched from gstatic, and CanvasKit
    #                compiles WebAssembly, which needs wasm-unsafe-eval. The
    #                sha256 is index.html's inline splash script — hashed
    #                rather than allowed with 'unsafe-inline', which would
    #                permit every injected script as well as this one. The
    #                Dockerfile computes it from the built file, so it cannot
    #                drift from what is actually served.
    #   style-src    Flutter writes its own inline styles into the document.
    #   img-src      data: because item photos and the company logo are stored
    #                as base64 and rendered straight from it.
    #   font-src     the engine falls back to Roboto from fonts.gstatic.com
    #                for glyphs the bundled faces lack.
    #   connect-src  'self' is the /api proxy; gstatic is the engine download.
    #   worker-src   blob: is how the engine starts its workers.
    #
    # frame-ancestors 'none' is the clickjacking half, and is a header-only
    # directive — a <meta> CSP cannot express it, which is why this lives here
    # rather than in the document.
    set $csp "default-src 'none'; script-src 'self' https://www.gstatic.com 'wasm-unsafe-eval' '__INLINE_SCRIPT_HASH__'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://www.gstatic.com https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'";

    # The container's own liveness probe. Deliberately not proxied, so it
    # reports on *this* service rather than on the API behind it.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # A RESTORE IS THE ONE BIG REQUEST THIS APP MAKES. Everything else is
    # small JSON — the 8m above is a sensible guard for it — but a full backup
    # carries every row including item photos, which are stored inline as
    # base64. A catalogue with a few hundred photographed items runs to tens of
    # megabytes, and nginx answered 413 with an HTML error page the app could
    # not even parse into a message. It read as "restore does not work".
    #
    # Its own location purely to raise the cap; the proxying is the same as
    # /api/ below, repeated because nginx has no way to vary one directive per
    # URI within a location.
    location = /api/inventory/restore {
        client_max_body_size 256m;

        # A restore replaces the whole workspace in one transaction, so it can
        # legitimately take longer than an ordinary request.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Streamed rather than spooled to disk first: the body is large and
        # buffering it twice helps nobody.
        proxy_request_buffering off;

        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $api_backend ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_backend;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_no_cache     1;
        proxy_cache_bypass 1;
    }

    # Same-origin API. The client is built with a relative base, so it calls
    # here and CORS never applies.
    location /api/ {
        # Docker's embedded DNS. Naming a resolver and putting the upstream in
        # a *variable* is what forces nginx to re-resolve: with a literal
        # host, it resolves once at startup and then keeps calling the address
        # the API container had before it was last replaced — so every deploy
        # would break the proxy until nginx itself was restarted.
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $api_backend ${API_UPSTREAM};

        # A variable upstream disables proxy_pass's automatic prefix
        # stripping, so /api is removed here instead. The API keeps serving
        # /auth/login rather than /api/auth/login either way.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_backend;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # The API only believes this when TRUST_PROXY_HEADERS is on, and it is
        # set here because this proxy overwrites rather than appends — so a
        # client cannot forge its own address past it.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        # An API response is either per-user or credential-bearing; nothing
        # here belongs in a shared cache.
        proxy_no_cache     1;
        proxy_cache_bypass 1;
    }

    # THE PREMISE OF THIS RULE WAS FALSE, AND IT PINNED THE APP TO ONE BUILD.
    #
    # It said "hashed build assets are safe to cache hard: a new build changes
    # the filename". Flutter web does not fingerprint its filenames. Every
    # build emits main.dart.js and flutter_bootstrap.js under those exact
    # names, and they were going out as `immutable, max-age=31536000` — so a
    # browser that had once loaded the site would not re-request either of
    # them for a year, whatever was deployed.
    #
    # index.html being no-store did not help: it only points at those two
    # names. Nor did the service worker, because the version it registers is
    # carried INSIDE flutter_bootstrap.js, which was itself pinned. Old
    # bootstrap, old worker version, old main.dart.js, indefinitely. Three
    # deploys landed on the origin, verified byte for byte with curl, while
    # every returning browser kept running the build from before them.
    #
    # So these revalidate now. ETag and Last-Modified make that a conditional
    # request: 304 and no body when nothing changed, which is what this used
    # to buy with a year of staleness.
    location ~* \.(?:js|css|wasm|json|otf|ttf|woff2?|png|jpg|jpeg|svg|ico)$ {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # pdf.js, served from here so the document preview needs no CDN and no
    # eval. Its files are ES modules ending .mjs, which nginx's stock types
    # list does not know: served as application/octet-stream, with nosniff,
    # the browser refuses to run them. The fonts are binary and stay so.
    location ^~ /pdfjs/ {
        types {
            text/javascript          mjs;
            application/octet-stream pfb;
        }
        default_type application/octet-stream;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # The engine is the one thing here that IS addressed by version: its files
    # live under a path that changes with the engine, so a stale one is never
    # asked for. (The app loads this from the CDN by default; served locally
    # it caches the same way.)
    location ^~ /canvaskit/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # index.html must never be cached, or a deploy leaves browsers loading the
    # previous build's asset manifest and the app fails to boot.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy $csp always;
        try_files $uri =404;
    }

    location = /flutter_service_worker.js {
        add_header Cache-Control "no-store, must-revalidate";
        try_files $uri =404;
    }

    # Single-page app: unknown paths are routes, not missing files. The app
    # uses hash URLs by default, so this mainly matters if it is ever switched
    # to path URLs — at which point a deep link would 404 without it.
    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy $csp always;
        try_files $uri $uri/ /index.html;
    }
}
