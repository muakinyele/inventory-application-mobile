# Stockpile identity API — configuration template.
#
# Copy to `server/.env` and fill in. `.env` is gitignored; this file is not,
# so never put a real secret in it.
#
# Values in the real process environment always win over this file, so a
# container's injected variables beat anything copied into the image.

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------

# `production` turns on the strict checks: TOKEN_PEPPER and EMAIL_HOST become
# mandatory, APP_URL must be https, and the database connection requires TLS.
APP_ENV=development

PORT=8080
APP_NAME=Stockpile

# Base URL of the *client*, not the API. Every emailed link is built from this
# rather than from a request header, so a spoofed Host cannot point a password
# reset link at someone else's domain.
APP_URL=http://localhost:8080

DATABASE_URL=postgres://user:password@localhost:5432/stockpile_auth

# ---------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------

# Mixed into every token hash, so a stolen database alone cannot be used to
# forge a session. Generate with:
#
#     dart run bin/generate_secret.dart
#
# Required in production; must be at least 32 characters. Changing it signs
# everyone out and voids every outstanding reset and invitation link.
TOKEN_PEPPER=

# ---------------------------------------------------------------------
# Email (§15)
# ---------------------------------------------------------------------
#
# Leave EMAIL_HOST empty in development and mail is logged instead of sent —
# the invite endpoint then returns the invitation link directly so the flow
# still completes. In production an empty EMAIL_HOST refuses to boot, because
# password resets would silently fail.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Stockpile <no-reply@example.com>

# Implicit TLS on connect (port 465). Leave false for STARTTLS on 587.
EMAIL_SSL=false

# --- Gmail / Google Workspace ---------------------------------------
#
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_SSL=false                      # 587 is STARTTLS, not implicit TLS
#   EMAIL_USERNAME=you@yourdomain.com    # the full address, not just the user
#   EMAIL_PASSWORD=<16-char app password>
#   EMAIL_FROM=Stockpile <you@yourdomain.com>
#
# The password must be an **app password**, not the account password: Google
# rejects the account password for SMTP whenever 2-step verification is on.
# Generate one at https://myaccount.google.com/apppasswords — it is shown as
# four groups of four, and the spaces are display only.
#
# EMAIL_FROM should match EMAIL_USERNAME. Gmail rewrites the From header to
# the authenticated account anyway, so a mismatch just makes the sent mail
# disagree with what you configured.
#
# Some networks block port 465 outbound while leaving 587 open. Check with:
#   dart run tool/send_test_email.dart you@example.com

# Permits an unencrypted SMTP connection. Only for a local Mailpit/MailHog
# container — never with real credentials.
EMAIL_ALLOW_INSECURE=false

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------

# Comma-separated exact origins allowed to call the API from a browser. There
# is no wildcard: an unlisted origin is refused. Defaults to APP_URL.
CORS_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------
# Sessions and tokens
# ---------------------------------------------------------------------

# Short, because a leaked access token stays useful only this long.
ACCESS_TOKEN_TTL_MINUTES=15

# How long a device stays signed in without re-entering a password.
REFRESH_TOKEN_TTL_HOURS=720

INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24

# ---------------------------------------------------------------------
# Brute-force protection (§19)
# ---------------------------------------------------------------------

# Consecutive failures before an account locks. The lock expires by itself
# after LOCKOUT_MINUTES, so it can never be used to lock someone out for good.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------

# Only set true when a reverse proxy you control sets X-Forwarded-For. If the
# API is reachable directly, a client can spoof the header and walk past the
# per-IP throttle.
TRUST_PROXY_HEADERS=false
